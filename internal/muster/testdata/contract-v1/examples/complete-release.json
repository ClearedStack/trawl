{
  "about": "The owner decides to release a held item. Countersign completes the release step with the state it was given and the decision: the item goes back to its worker in the urgent lane, in that state.",
  "given": {
    "items": [
      {
        "id": "PA-0001",
        "state": "recorded",
        "lane": "normal",
        "next": "sextant"
      }
    ],
    "calls": [
      {
        "as": "sextant",
        "method": "POST",
        "path": "/v1/lease",
        "body": {
          "contract": "v1"
        }
      },
      {
        "as": "sextant",
        "method": "POST",
        "path": "/v1/fail",
        "body": {
          "contract": "v1",
          "lease": "PA-0001.1",
          "code": "E_PARSE"
        }
      },
      {
        "as": "countersign",
        "method": "POST",
        "path": "/v1/lease",
        "body": {
          "contract": "v1"
        }
      }
    ]
  },
  "request": {
    "as": "countersign",
    "method": "POST",
    "path": "/v1/complete",
    "body": {
      "contract": "v1",
      "lease": "release:PA-0001.2",
      "state": "recorded",
      "result": {
        "decision": "release"
      }
    }
  },
  "expect": {
    "status": 200,
    "body": {
      "id": "PA-0001",
      "state": "recorded",
      "next": "sextant"
    }
  }
}
