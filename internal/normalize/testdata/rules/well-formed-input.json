{
  "rule": "well-formed-input",
  "spec": "One address per line, at most 4096 bytes after trimming spaces, tabs and line ends; no whitespace or control characters inside.",
  "cases": [
    {
      "name": "surrounding whitespace is trimmed",
      "input": "  \thttps://example.org/tool \r",
      "canonical": "https://example.org/tool",
      "sha256": "8bbaea237f77c077897f93aa14a93b41959d395d5cef040abfd93f62e077cc0a"
    },
    {
      "name": "exactly 4096 bytes is accepted",
      "input": "https://example.",
      "canonical": "https://example.",
      "sha256": "cb0f7a81b437f67f0e70eeb399922bc5b2da40594face0954a959ec0728311cc"
    },
    {
      "name": "empty",
      "input": "",
      "code": "E_PARSE",
      "reason": "empty"
    },
    {
      "name": "whitespace only",
      "input": " \t ",
      "code": "E_PARSE",
      "reason": "empty"
    },
    {
      "name": "4097 bytes",
      "input": "https://example.",
      "code": "E_PARSE",
      "reason": "too_long"
    },
    {
      "name": "space inside",
      "input": "https://example.org/rate calculator",
      "code": "E_PARSE",
      "reason": "bad_character"
    },
    {
      "name": "tab inside",
      "input": "https://example.org/a\tb",
      "code": "E_PARSE",
      "reason": "bad_character"
    },
    {
      "name": "control character inside",
      "input": "https://example.org/a\u0001b",
      "code": "E_PARSE",
      "reason": "bad_character"
    },
    {
      "name": "delete character inside",
      "input": "https://example.org/a\u007fb",
      "code": "E_PARSE",
      "reason": "bad_character"
    },
    {
      "name": "two addresses on one line",
      "input": "https://example.org/a https://example.org/b",
      "code": "E_PARSE",
      "reason": "bad_character"
    }
  ]
}
