      "sha256": "8198d1bac40a1033653a78e48800cefc9e6b974ff075c66e5548b5c1e145a2b0"
    },
    {
      "name": "no path becomes root",
      "input": "https://example.org",
      "canonical": "https://example.org/",
      "sha256": "8198d1bac40a1033653a78e48800cefc9e6b974ff075c66e5548b5c1e145a2b0"
    },
    {
      "name": "several root slashes",
      "input": "https://example.org///",
      "canonical": "https://example.org/",
      "sha256": "8198d1bac40a1033653a78e48800cefc9e6b974ff075c66e5548b5c1e145a2b0"
    },
    {
      "name": "no path with query",
      "input": "https://example.org?id=7",
      "canonical": "https://example.org/?id=7",
      "sha256": "35a778edeb48a3bb4d16168e659f1189154aaed68fc198a8d046b0c5b2590deb"
